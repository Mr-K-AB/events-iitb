# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eventdb

# ---- Backend secret ----
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Access control ----
ALLOWED_EMAIL_DOMAIN=iitb.ac.in
# Comma-separated emails auto-promoted to admin + approved organizer on signup/login.
# Sign up with one of these emails FIRST so you have an admin account from the start.
ADMIN_EMAILS=your-admin@iitb.ac.in

# ---- Ports ----
BACKEND_PORT=8000
FRONTEND_PORT=8501